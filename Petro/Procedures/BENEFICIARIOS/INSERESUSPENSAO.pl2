namespace 'Prestadores.BENEFICIARIOS';
procedure INSERESUSPENSAO;

version '1.0.0.0';

rem 'Inserir Suspensão nos beneficiários para que impacte nas autorizações e processamento de contas';


begin
  INSERT INTO SAM_BENEFICIARIO_SUSPENSAO (HANDLE,
          DATAINICIAL,
          MOTIVOSUSPENSAO,
          BENEFICIARIO,
          FATURARMESESSUSPENSOS,
          INFORMACOES)
SELECT Seq_Sam_Beneficiario_Suspensao.Nextval HANDLE,
       B.DATAADESAO DATAINICIAL,
       MS.HANDLE MOTIVOSUSPENSAO,
       B.HANDLE BENEFICIARIO,
       'N' FATURARMESESSUSPENSOS,
       'SUSPENSAO MIGRADA' INFORMACOES
  FROM SAM_BENEFICIARIO B
  JOIN SAM_SITUACAORH SRH ON (SRH.HANDLE = B.SITUACAORH AND SRH.CONTRATO = B.CONTRATO)
  JOIN SAM_MOTIVOSUSPENSAO MS ON (SRH.MOTIVOSUSPENSAO = MS.HANDLE)
WHERE SRH.TABTIPOSITUACAO = '3'  
   AND NOT EXISTS (SELECT 1
                    FROM SAM_BENEFICIARIO_SUSPENSAO BS2 WHERE BS2.BENEFICIARIO =B.HANDLE);
end;