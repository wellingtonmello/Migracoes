procedure IMPORTACAO_ENDERECO;

version '1.0.0.0';

rem 'Descrever a funcionalidade da procedure';

declare
  v_Var1                        int;
  v_Var2                        int;

begin
  UPDATE SAM_PRESTADOR_ENDERECO
     SET DATACANCELAMENTO = K_DATACANCELAMENTOMIG
   WHERE K_DATACANCELAMENTOMIG is not NULL;
   
  MERGE INTO SAM_PRESTADOR_ENDERECO E
USING (SELECT TMP.CCTIPOLOGRADOURO, TPL.HANDLE
         FROM TMP_TIPOLOGRADOURO_MIG TMP
		 JOIN LOGRADOUROS_TIPO TPL ON (TPL.CODIGO = TMP.CODIGOBENNER)) X ON (X.CCTIPOLOGRADOURO = E.K_TIPOLOGRADOUROMIG)
WHEN MATCHED THEN
  UPDATE SET E.TIPOLOGRADOURO = X.HANDLE   
  
  
UPDATE SAM_PRESTADOR_ENDERECO
   SET NUMERO = REGEXP_SUBSTR(LOGRADOURO, '\d+', 1, REGEXP_COUNT(LOGRADOURO, '\d+'))
  WHERE NVL(NUMERO,0) = 0
    AND REGEXP_COUNT(LOGRADOURO, '\d+') > 0  
end;